{
  "name": "calvin-hickey-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Personal portfolio site for Calvin Hickey. Static HTML, CSS and JavaScript with no build step.",
  "license": "MIT",
  "author": "Calvin Hickey",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "serve": "serve site --listen 4173",
    "format": "prettier --write .",
    "lint": "npm run lint:format && npm run lint:css && npm run lint:js && npm run lint:html",
    "lint:format": "prettier --check .",
    "lint:css": "stylelint \"site/**/*.css\"",
    "lint:js": "eslint .",
    "lint:html": "html-validate \"site/**/*.html\"",
    "icons": "node scripts/build-icons.js",
    "images": "node scripts/optimize-images.js",
    "fonts": "node scripts/copy-fonts.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "html-validate": "^11.16.2",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
